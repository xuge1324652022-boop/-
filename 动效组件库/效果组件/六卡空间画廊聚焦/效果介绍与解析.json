        "focusEase",
        "INTRO_DURATION",
        "FOCUS_DURATION"
      ],
      "purpose": "六卡位姿、裁切、明暗与投影的唯一数学来源。"
    },
    {
      "file": "src/experience/transitions/index.ts",
      "symbols": [
