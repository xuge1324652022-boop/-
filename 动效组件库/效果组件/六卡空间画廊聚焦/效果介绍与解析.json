{
  "$schema": "../../解析格式规范.json",
  "schemaVersion": "1.0.0",
  "id": "gallery-focus",
  "title": {
    "zh": "六卡空间画廊与全屏聚焦",
    "en": "Six-card gallery and fullscreen focus"
  },
  "category": "transition",
  "status": "active",
  "summary": "以 CSS 3D 正交环承载六个求职作品方向。几何由纯函数计算，宿主统一渲染，GSAP 只插值 entrance、orbit 与 focus；章节转场单独只推进 focus，让选中卡铺满视口、其余卡原地淡出。",
  "entryFiles": [
    "src/components/ThreeHome.vue",
    "src/experience/transitions/index.ts",
    "src/experience/state.ts",
    "src/utils/galleryMotion.ts"
  ],
