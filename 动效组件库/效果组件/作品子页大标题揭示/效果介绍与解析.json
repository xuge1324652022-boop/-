{
  "$schema": "../../解析格式规范.json",
  "schemaVersion": "1.0.0",
  "id": "subpage-heading-reveal",
  "title": {
    "zh": "作品子页大标题揭示",
    "en": "Subpage heading entrance"
  },
  "category": "text",
  "status": "active",
  "summary": "摄影、海报、剪辑/新闻三类宿主使用同一揭幕门闩，先播放标题的上移渐显，再放行介绍与正文入场；本目录保留各宿主完整实现供迁移对照。",
  "entryFiles": [
    "src/views/PhotoView.vue",
    "src/views/PosterView.vue",
    "src/views/FoundationView.vue"
  ],
  "integrationFiles": [
    "src/App.vue"
  ],
  "sourceSections": [
    {
      "file": "src/views/PhotoView.vue",
      "symbols": [
        "playIntro",
        "buildReveal",
        "introGone"
      ],
      "purpose": "摄影标题与正文揭示的交接。"
    },
    {
      "file": "src/views/PosterView.vue",
      "symbols": [
        "playIntro",
        "onMotionChange"
      ],
      "purpose": "海报标题与运行中减少动态切换。"
    },
    {
      "file": "src/views/FoundationView.vue",
      "symbols": [
        "playIntro",
        "revealStudy"
      ],
      "purpose": "基础页标题及后续主题研究的视口入场。"
    }
  ],
  "mechanism": {
    "trigger": "covered由routeCurtainBlocked、jumpTarget、overlayActive、isTransitioning派生，转false时playIntro只运行一次。",
    "stages": [
      {
        "name": "摄影标题",
        "description": "标题从40%偏移和透明进入原位；完成后introGone放行正文。",
        "properties": [
          "yPercent",
          "opacity"
        ],
        "timing": "0.9s，power3.out"
      },
      {
        "name": "海报标题",
        "description": "标题从40%偏移和透明进入原位，随后建立setupAboutReveal。",
        "properties": [
          "yPercent",
          "opacity"
        ],
        "timing": "1.2s，power2.out"
      },
      {
        "name": "基础页标题及研究",
        "description": "基础页标题从30%偏移进入；研究区再按视口首次进入。",
        "properties": [
          "yPercent",
          "opacity",
          "y"
        ],
        "timing": "标题0.8s；研究区y:54→0、1s、start:top 85%，power3.out"
      }
    ],
    "state": [
      "introPlayed/started防止重复",
      "introGone/introDone放行共享介绍",
      "disposed拒绝卸载后nextTick"
    ],
    "propertyOwnership": [
      "宿主仅动画标题节点；ReferenceIntroduction独立分行并持有正文行补间",
      "文字拟合字号由useFitText负责"
    ],
    "interruption": [
      "卸载kill标题timeline并dispose正文揭示",
      "Poster/Foundation监听运行中减少动态；Photo只初始化读取该偏好"
    ]
  },
  "integration": {
    "steps": [
      "按目标页面选择一个宿主，抽取playIntro和covered门闩并保持参数。",
      "在根页面provide(referenceIntroductionGate)，标题结束后放行正文。",
      "迁移完整页面时同步数据、查看器和滚动样式；仅复用标题时删除无关页面块并自行重新验证。"
    ],
    "inputs": [
      "路由幕布共享状态",
      "标题ref",
      "页面kind或作品数据"
    ],
    "outputs": [
      "introGone/introDone",
      "referenceIntroductionGate"
    ],
    "dependencies": [
      "vue",
      "vue-router",
      "gsap",
      "ScrollTrigger",
      "useFitText",
      "setupAboutReveal"
    ],
    "assets": [
      "完整页面仍引用public/portfolio和public/internship-clean，标题效果本身无媒体依赖"
    ]
  },
  "accessibility": {
    "reducedMotion": "初始化为reduce时直接显示终态；Poster/Foundation动态切换会kill并清属性。",
    "touch": "使用原生文档滚动，无标题专属触摸手势。",
    "keyboard": "保留页面原生按钮、链接及基础页页签键盘交互。"
  },
  "lifecycle": {
    "setup": [
      "onMounted/nextTick后检查covered并建立上下文",
      "页面门闩watch触发一次性标题"
    ],
    "cleanup": [
      "disposed标记",
      "kill introTimeline、dispose reveal或context.revert",
      "移除页面自己的偏好与媒体监听"
    ],
    "knownLimitations": [
      "这里是完整宿主快照，不能把三个页面一并当成同一组件重复挂载。",
      "PhotoView当前不监听运行中prefers-reduced-motion变化；保留现状供后续修复。"
    ]
  },
  "agentNotes": [
    "标题时间单位为秒；触发与幕布active完全解锁是不同阶段。",
    "只复用标题时不要同时让useAboutReveal再动画同一个标题。"
  ],
  "relatedEffects": [
    "route-curtain",
    "text-line-reveal",
    "about-scroll-reveal",
    "fit-text"
  ],
  "verification": {
    "commands": [
      "npm run check:motion",
      "npm run typecheck",
      "npm run test:deployment"
    ],
    "manualChecks": [
      "从六卡和子页索引进入，观察标题未在幕下播放完。",
      "慢导航、后退与减少动态条件下确认内容可读且滚动解锁。"
    ]
  },
  "tags": [
    "gsap",
    "heading",
    "route-gate",
    "one-shot"
  ],
  "bundle": {
    "format": "repository-source-bundle",
    "standalone": false,
    "textEncoding": "UTF-8, LF (CRLF normalized)",
    "entryDirectory": "源码/",
    "integrationContextDirectory": "集成示例/",
    "entryFiles": [
      "源码/项目源码/页面/摄影作品页.vue",
      "源码/项目源码/页面/海报作品页.vue",
      "源码/项目源码/页面/基础作品页.vue"
    ],
    "namingMap": "../../命名映射.json",
    "imports": "源码/ 使用中文目录和文件名，按命名映射改写本地导入并包含传递源码依赖；集成示例/ 仅保留调用上下文，其依赖不保证完整。原始标识符及运行逻辑保持不变。",
    "assets": "Directly imported src/assets images are included with original bytes; public images/videos/PDF files and third-party packages remain external references.",
    "sourceOfTruth": "Edit the root src/ files, then npm run build:motion; do not edit generated snapshots.",
    "browserOnly": true
  },
  "npmDependencies": [
