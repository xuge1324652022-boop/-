{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "求职模板网站动效介绍与源码解析规范",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "category",
    "status",
    "summary",
    "entryFiles",
    "integrationFiles",
    "sourceSections",
    "mechanism",
    "integration",
    "accessibility",
    "lifecycle",
    "agentNotes",
    "relatedEffects",
    "verification",
    "tags"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "#/$defs/bilingual"
    },
    "category": {
      "enum": [
        "mask",
        "transition",
        "card",
        "overlay",
        "scroll",
        "text",
        "media",
        "pointer",
        "layout"
      ]
    },
    "status": {
      "enum": [
        "active",
        "legacy"
      ]
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "entryFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourcePath"
      }
    },
    "integrationFiles": {
      "$ref": "#/$defs/sourcePaths"
    },
    "sourceSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "symbols",
          "purpose"
        ],
        "properties": {
          "file": {
            "$ref": "#/$defs/sourcePath"
          },
          "symbols": {
            "$ref": "#/$defs/strings"
          },
          "purpose": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "stages",
        "state",
        "propertyOwnership",
        "interruption"
      ],
      "properties": {
        "trigger": {
          "$ref": "#/$defs/text"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "properties",
              "timing"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "description": {
                "$ref": "#/$defs/text"
              },
              "properties": {
                "$ref": "#/$defs/strings"
              },
              "timing": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "state": {
          "$ref": "#/$defs/strings"
        },
        "propertyOwnership": {
          "$ref": "#/$defs/strings"
        },
        "interruption": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "inputs",
        "outputs",
        "dependencies",
        "assets"
      ],
      "properties": {
        "steps": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "inputs": {
          "$ref": "#/$defs/strings"
        },
        "outputs": {
          "$ref": "#/$defs/strings"
        },
        "dependencies": {
          "$ref": "#/$defs/strings"
        },
        "assets": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reducedMotion",
        "touch",
        "keyboard"
      ],
      "properties": {
        "reducedMotion": {
          "$ref": "#/$defs/text"
        },
        "touch": {
          "$ref": "#/$defs/text"
        },
        "keyboard": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "cleanup",
        "knownLimitations"
      ],
      "properties": {
        "setup": {
          "$ref": "#/$defs/strings"
        },
        "cleanup": {
          "$ref": "#/$defs/strings"
        },
        "knownLimitations": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "agentNotes": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "relatedEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "manualChecks"
      ],
      "properties": {
        "commands": {
          "$ref": "#/$defs/strings"
        },
        "manualChecks": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "tags": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "standalone",
        "textEncoding",
        "entryDirectory",
        "integrationContextDirectory",
        "imports",
        "assets",
        "sourceOfTruth",
        "browserOnly",
        "entryFiles",
        "namingMap"
      ],
      "properties": {
        "format": {
          "const": "repository-source-bundle"
        },
        "standalone": {
          "const": false
        },
        "textEncoding": {
          "$ref": "#/$defs/text"
        },
        "entryDirectory": {
          "const": "源码/"
        },
        "integrationContextDirectory": {
          "const": "集成示例/"
        },
        "imports": {
          "$ref": "#/$defs/text"
        },
        "assets": {
          "$ref": "#/$defs/text"
        },
        "sourceOfTruth": {
          "$ref": "#/$defs/text"
        },
        "browserOnly": {
          "const": true
        },
        "entryFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^源码/项目源码/"
          }
        },
        "namingMap": {
          "const": "../../命名映射.json"
        }
      }
    },
    "npmDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specifier",
          "package",
          "requested",
          "locked"
        ],
        "properties": {
          "specifier": {
            "$ref": "#/$defs/text"
          },
          "package": {
            "$ref": "#/$defs/text"
          },
          "requested": {
            "$ref": "#/$defs/text"
          },
          "locked": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original",
          "path",
          "role",
          "sha256",
          "bytes",
          "originalSha256",
          "originalBytes"
        ],
        "properties": {
          "original": {
            "$ref": "#/$defs/sourcePath"
          },
          "path": {
            "type": "string",
            "pattern": "^(?:源码/项目源码/|集成示例/(?:项目源码/|开场页面\\.html$))"
          },
          "role": {
            "enum": [
              "entry",
              "dependency",
              "global-style",
              "imported-asset",
              "integration-context"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "originalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "originalBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(?:index\\.html|src/(?!.*(?:\\\\|(?:^|/)\\.\\.(?:/|$))).+\\.(?:vue|ts|js|css|json|jpg|jpeg|png|webp|svg))$"
    },
    "sourcePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourcePath"
      }
    },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/text"
        },
        "en": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
